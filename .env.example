# Copy to .env (or set as real environment variables / platform secrets) and fill in.
# Never commit a real .env file.

# --- Auth (required) ---
# Single account:
GODSEYE_USERNAME=changeme
GODSEYE_PASSWORD=change-this-to-a-long-random-passphrase
# Or multiple accounts instead of the two vars above:
# GODSEYE_USERS=alice:passphrase-one,bob:passphrase-two

# Flask session signing key (required in production) -- generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to 0 only for local plain-HTTP testing. Keep at 1 (default) in production
# so the session cookie requires HTTPS.
# FORCE_HTTPS=1

# --- Optional ---
# Enables the "Claude AI executive summary" option on the scan form.
# ANTHROPIC_API_KEY=sk-ant-...
